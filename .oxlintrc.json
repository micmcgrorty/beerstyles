{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"react/react-in-jsx-scope": "off",
		"jsx-a11y/prefer-tag-over-role": "off"
	},
	"env": {
		"builtin": true,
		"node": true
	},
	"ignorePatterns": [".agents/**"]
}
