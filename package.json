{
	"name": "beerstyles",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --watch --import remix/node-tsx server.ts",
		"start": "node --env-file=.env.production --import remix/node-tsx server.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"typecheck": "tsc",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"remix": "^3.1.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.65.0",
		"@types/node": "26.6.6",
		"oxfmt": "0.77.0",
		"oxlint": "1.92.0",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"engines": {
		"node": ">=24.3.0"
	}
}
